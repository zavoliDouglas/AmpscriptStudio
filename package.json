{
  "name": "amp-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extensao Chrome (MV3) para formatar e validar AMPscript e SSJS dentro do Content Builder do Salesforce Marketing Cloud.",
  "scripts": {
    "dev": "vite",
    "build:panel": "vite build",
    "build:ext": "node scripts/build-extension.mjs",
    "build": "npm run build:panel && npm run build:ext",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.0",
    "codemirror": "^6.0.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
